#!/usr/bin/env bash
set -euo pipefail

umask 077

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_dir="$(cd -- "$(dirname -- "$script_path")/.." && pwd -P)"
archive_root="${APPLICATIONLAUNCHER_BUILD_ARCHIVE:-${XDG_STATE_HOME:-$HOME/.local/state}/applicationlauncher/builds}"
keep_builds="${APPLICATIONLAUNCHER_BUILD_KEEP_BUILDS:-3}"
run_build=true
temporary_dirs=()

cleanup() {
	local directory
	for directory in "${temporary_dirs[@]}"; do
		[[ -n "$directory" ]] && rm -rf -- "$directory"
	done
}

trap cleanup EXIT

print_help() {
	cat <<'EOF'
NAME
    build-debuggable-release - Build and archive production Application Launcher artifacts

SYNOPSIS
    build-debuggable-release [--archive DIRECTORY] [--keep-builds COUNT] [--no-build]

DESCRIPTION
    Builds the exact release configuration, extracts each ELF build ID, and
    archives the exact unstripped binary, a stripped deployment copy, separate
    debug symbols, build-info.json, and checksums under that build ID.

OPTIONS
    --archive DIRECTORY
        Override the archive root. The default is
        $XDG_STATE_HOME/applicationlauncher/builds.

    --keep-builds COUNT
        Retain the newest COUNT archives for each component, in addition to
        archives used by running processes. The default is 3.

    --no-build
        Archive existing target/release binaries without invoking Cargo.

    -h, --help
        Print this help and exit.

OPERATION
    Cargo produces full DWARF and a GNU build ID. This script never modifies the
    target/release executable. It creates a private, idempotent archive indexed
    by the executable's ELF build ID, then removes archives outside the bounded
    retention window unless a running process still uses that build ID.

EXAMPLES
    scripts/build-debuggable-release
        Build and archive both production binaries.

    scripts/build-debuggable-release --archive /tmp/applicationlauncher-builds
        Write a disposable verification archive.

FILES
    target/release/applicationlauncher
    target/release/applicationlauncherd
    ARCHIVE/by-build-id/BUILD_ID/build-info.json

PATHS
    ARCHIVE/by-build-id/BUILD_ID/
        Contains exact, stripped, and debug-symbol artifacts for one ELF.

SECURITY NOTES
    Build metadata may contain local source paths. Archive directories and files
    are private to the current user. Debug symbols are not installed system-wide.

EXIT STATUS
    0   Build and archive completed.
    1   A required tool, build, ELF identity, budget, or archive step failed.

AUTHORS
    Terrydaktal <9lewis9@gmail.com>
EOF
}

while (($# > 0)); do
	case "$1" in
	--archive)
		[[ $# -ge 2 ]] || {
			printf '%s\n' 'build-debuggable-release: --archive requires a directory' >&2
			exit 1
		}
		archive_root="$2"
		shift 2
		;;
	--no-build)
		run_build=false
		shift
		;;
	--keep-builds)
		[[ $# -ge 2 ]] || {
			printf '%s\n' 'build-debuggable-release: --keep-builds requires a count' >&2
			exit 1
		}
		keep_builds="$2"
		shift 2
		;;
	-h | --help)
		print_help
		exit 0
		;;
	*)
		printf 'build-debuggable-release: unknown option: %s\n' "$1" >&2
		exit 1
		;;
	esac
done

[[ "$keep_builds" =~ ^[1-9][0-9]*$ ]] || {
	printf 'build-debuggable-release: keep-builds must be a positive integer: %s\n' "$keep_builds" >&2
	exit 1
}

for command in cargo flock git jq objcopy readelf rustc sha256sum stat; do
	command -v "$command" >/dev/null 2>&1 || {
		printf 'build-debuggable-release: required command not found: %s\n' "$command" >&2
		exit 1
	}
done

if [[ "$run_build" == true ]]; then
	cargo build --manifest-path "$repo_dir/Cargo.toml" --release --locked --bins
fi

mkdir -p -- "$archive_root/by-build-id"
chmod 700 "$archive_root" "$archive_root/by-build-id"
exec {archive_lock_fd}>"$archive_root/.archive.lock"
chmod 600 "$archive_root/.archive.lock"
flock "$archive_lock_fd"

git_revision="$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null || printf unknown)"
git_dirty=false
dirty_hash="clean"
git_status="$(git -C "$repo_dir" status --porcelain=v1 --untracked-files=all 2>/dev/null || true)"
if [[ -n "$git_status" ]]; then
	git_dirty=true
	dirty_hash="$({
		printf '%s\n' "$git_status"
		git -C "$repo_dir" diff --binary --
		git -C "$repo_dir" diff --cached --binary --
		while IFS= read -r -d '' untracked; do
			printf 'untracked %s\n' "$untracked"
			sha256sum "$repo_dir/$untracked"
		done < <(git -C "$repo_dir" ls-files --others --exclude-standard -z)
	} | sha256sum | awk '{print $1}')"
fi

rustc_version="$(rustc -vV)"
cargo_version="$(cargo -V)"
linker_version="$(cc --version 2>/dev/null | sed -n '1p' || printf unavailable)"
dependency_graph="$(cargo tree --manifest-path "$repo_dir/Cargo.toml" --locked --prefix none)"
target_triple="$(rustc -vV | sed -n 's/^host: //p')"
source_epoch="$(date +%s)"
archive_manifest='[]'

for component in applicationlauncher applicationlauncherd; do
	binary="$repo_dir/target/release/$component"
	[[ -x "$binary" ]] || {
		printf 'build-debuggable-release: missing release binary: %s\n' "$binary" >&2
		exit 1
	}

	elf_build_id="$(readelf -n "$binary" | sed -n 's/.*Build ID: //p' | sed -n '1p')"
	[[ "$elf_build_id" =~ ^[0-9a-fA-F]{16,}$ ]] || {
		printf 'build-debuggable-release: %s has no valid ELF build ID\n' "$binary" >&2
		exit 1
	}
	application_build_id="$("$binary" --build-id)"
	artifact_dir="$archive_root/by-build-id/$elf_build_id"
	temporary_dir="$archive_root/by-build-id/.${elf_build_id}.$$"
	mkdir -p -- "$temporary_dir"
	temporary_dirs+=("$temporary_dir")

	cp --reflink=auto -- "$binary" "$temporary_dir/$component.unstripped"
	cp --reflink=auto -- "$binary" "$temporary_dir/$component"
	objcopy --only-keep-debug "$binary" "$temporary_dir/$component.debug"
	objcopy --strip-debug "$temporary_dir/$component"
	(
		cd -- "$temporary_dir"
		objcopy --add-gnu-debuglink="$component.debug" "$component"
	)
	chmod 700 "$temporary_dir/$component" "$temporary_dir/$component.unstripped"
	chmod 600 "$temporary_dir/$component.debug"

	exact_sha256="$(sha256sum "$temporary_dir/$component.unstripped" | awk '{print $1}')"
	stripped_sha256="$(sha256sum "$temporary_dir/$component" | awk '{print $1}')"
	debug_sha256="$(sha256sum "$temporary_dir/$component.debug" | awk '{print $1}')"
	exact_size="$(stat -c %s "$temporary_dir/$component.unstripped")"
	stripped_size="$(stat -c %s "$temporary_dir/$component")"
	debug_size="$(stat -c %s "$temporary_dir/$component.debug")"

	((stripped_size <= 67108864)) || {
		printf 'build-debuggable-release: %s stripped size exceeds 64 MiB budget\n' "$component" >&2
		exit 1
	}
	((exact_size <= 536870912 && debug_size <= 536870912)) || {
		printf 'build-debuggable-release: %s symbol archive exceeds 512 MiB budget\n' "$component" >&2
		exit 1
	}

	jq -n \
		--arg component "$component" \
		--arg package_version "$(cargo metadata --manifest-path "$repo_dir/Cargo.toml" --locked --no-deps --format-version 1 | jq -r '.packages[0].version')" \
		--arg application_build_id "$application_build_id" \
		--arg elf_build_id "$elf_build_id" \
		--arg git_revision "$git_revision" \
		--argjson git_dirty "$git_dirty" \
		--arg dirty_hash "$dirty_hash" \
		--arg target "$target_triple" \
		--arg profile release \
		--arg rustc "$rustc_version" \
		--arg cargo "$cargo_version" \
		--arg linker "$linker_version" \
		--arg rustflags "${RUSTFLAGS:-}" \
		--arg dependencies "$dependency_graph" \
		--arg exact_sha256 "$exact_sha256" \
		--arg stripped_sha256 "$stripped_sha256" \
		--arg debug_sha256 "$debug_sha256" \
		--argjson exact_size "$exact_size" \
		--argjson stripped_size "$stripped_size" \
		--argjson debug_size "$debug_size" \
		--argjson generated_unix_time "$source_epoch" \
		'{
            schema_version: 1,
            component: $component,
            package_version: $package_version,
            application_build_id: $application_build_id,
            elf_build_id: $elf_build_id,
            source: {revision: $git_revision, dirty: $git_dirty, dirty_hash: $dirty_hash},
            build: {
                profile: $profile,
                target: $target,
                features: ["default"],
                rustflags: $rustflags,
                configured_rustflags: ["-C", "link-arg=-Wl,--build-id=sha1"],
                release_profile: {opt_level: 3, debug: 2, split_debuginfo: "off", strip: "none", panic: "unwind"},
                rustc: $rustc,
                cargo: $cargo,
                linker: $linker,
                dependencies: ($dependencies | split("\n"))
            },
            artifacts: {
                exact_unstripped: {file: ($component + ".unstripped"), sha256: $exact_sha256, bytes: $exact_size},
                stripped: {file: $component, sha256: $stripped_sha256, bytes: $stripped_size},
                debug: {file: ($component + ".debug"), sha256: $debug_sha256, bytes: $debug_size}
            },
            generated_unix_time: $generated_unix_time
        }' >"$temporary_dir/build-info.json"
	chmod 600 "$temporary_dir/build-info.json"
	(
		cd -- "$temporary_dir"
		sha256sum "$component" "$component.debug" "$component.unstripped" build-info.json >manifest.sha256
	)
	chmod 600 "$temporary_dir/manifest.sha256"

	if [[ -d "$artifact_dir" ]]; then
		existing_exact_sha256="$(jq -r '.artifacts.exact_unstripped.sha256 // empty' "$artifact_dir/build-info.json" 2>/dev/null || true)"
		if [[ "$existing_exact_sha256" != "$exact_sha256" ]] || ! (
			cd -- "$artifact_dir"
			sha256sum --check --status manifest.sha256
		); then
			printf 'build-debuggable-release: refusing to replace conflicting or corrupt archive: %s\n' "$artifact_dir" >&2
			exit 1
		fi
		rm -rf -- "$temporary_dir"
	else
		mv -- "$temporary_dir" "$artifact_dir"
		chmod 700 "$artifact_dir"
	fi

	archive_manifest="$(jq \
		--arg component "$component" \
		--arg elf_build_id "$elf_build_id" \
		'. + [{component: $component, elf_build_id: $elf_build_id}]' \
		<<<"$archive_manifest")"
done

jq -n \
	--argjson generated_unix_time "$source_epoch" \
	--arg git_revision "$git_revision" \
	--argjson git_dirty "$git_dirty" \
	--arg dirty_hash "$dirty_hash" \
	--argjson artifacts "$archive_manifest" \
	'{
        schema_version: 1,
        generated_unix_time: $generated_unix_time,
        source: {revision: $git_revision, dirty: $git_dirty, dirty_hash: $dirty_hash},
        artifacts: $artifacts
    }' >"$archive_root/latest-build.json"
chmod 600 "$archive_root/latest-build.json"

declare -A protected_build_ids=()
while IFS= read -r build_id; do
	[[ "$build_id" =~ ^[0-9a-fA-F]{16,}$ ]] && protected_build_ids["${build_id,,}"]=1
done < <(jq -r '.artifacts[].elf_build_id // empty' "$archive_root/latest-build.json")

for process_exe in /proc/[0-9]*/exe; do
	process_target="$(readlink "$process_exe" 2>/dev/null || true)"
	process_target="${process_target% (deleted)}"
	case "${process_target##*/}" in
	applicationlauncher | applicationlauncherd)
		build_id="$(readelf -n "$process_exe" 2>/dev/null | sed -n 's/.*Build ID: //p' | sed -n '1p')"
		[[ "$build_id" =~ ^[0-9a-fA-F]{16,}$ ]] && protected_build_ids["${build_id,,}"]=1
		;;
	esac
done

for component in applicationlauncher applicationlauncherd; do
	kept=0
	while IFS=$'\t' read -r generated_unix_time build_id; do
		[[ -n "$build_id" ]] || continue
		if ((kept < keep_builds)); then
			((kept += 1))
			continue
		fi
		[[ -n "${protected_build_ids[$build_id]:-}" ]] && continue

		artifact_dir="$archive_root/by-build-id/$build_id"
		printf 'Removing expired %s build archive %s\n' "$component" "$build_id"
		rm -rf -- "$artifact_dir"
	done < <(
		for artifact_dir in "$archive_root"/by-build-id/*; do
			[[ -d "$artifact_dir" && ! -L "$artifact_dir" ]] || continue
			build_info="$artifact_dir/build-info.json"
			[[ -f "$build_info" && ! -L "$build_info" ]] || continue
			[[ "$(jq -r '.component // empty' "$build_info" 2>/dev/null)" == "$component" ]] || continue

			build_id="${artifact_dir##*/}"
			[[ "$build_id" =~ ^[0-9a-fA-F]{16,}$ ]] || continue
			[[ "$(jq -r '.elf_build_id // empty' "$build_info" 2>/dev/null)" == "$build_id" ]] || continue
			generated_unix_time="$(jq -r '.generated_unix_time // 0' "$build_info" 2>/dev/null)"
			[[ "$generated_unix_time" =~ ^[0-9]+$ ]] || generated_unix_time=0
			printf '%020d\t%s\n' "$generated_unix_time" "${build_id,,}"
		done | sort -t $'\t' -k1,1nr -k2,2
	)
done

printf 'Archived debuggable release artifacts in %s\n' "$archive_root"
